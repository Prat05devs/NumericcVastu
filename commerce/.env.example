# NumericcVaastu commerce — sample environment. Copy to .env (local) or enter in hPanel → Node.js → Environment variables.
# NEVER commit real values. Generate secrets with: openssl rand -base64 48   (ENCRYPTION_KEY: openssl rand -base64 32)

# ── API (apps/api) ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME     # Hostinger: hPanel → Databases → MySQL
DATABASE_POOL_SIZE=5                                                # keep well below Hostinger's per-user connection cap
APP_BASE_URL=https://www.numericcvaastucrystal.in                   # the web app (links in emails)
API_BASE_URL=https://api.numericcvaastucrystal.in                   # this API (webhook URLs, local media)
CORS_ORIGINS=https://www.numericcvaastucrystal.in,https://numericcvaastucrystal.in
COOKIE_DOMAIN=                                                      # leave empty: the web proxies /api/v1 so cookies stay first-party
SESSION_SECRET=CHANGE_ME_48+_random_chars
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes                            # encrypts payment/AI keys, MFA secrets, private customer details. Back it up separately — data is unreadable without it.
CRON_JOB_SECRET=CHANGE_ME_48+_random_chars
WEB_REVALIDATE_SECRET=CHANGE_ME_24+_random_chars                    # same value in the web app

# Payments. Keys are normally entered (encrypted) in Back office → Payments setup; these env values are optional fallbacks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false                                           # go-live approval gate: set true only after sign-off (docs/runbooks/go-live.md)
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-in-dev-only

# Delivery partner webhooks (generic signed format; see docs/runbooks/delivery-partners.md)
SHIPPING_WEBHOOK_SECRET=

# Media / documents. local = disk under the API (development); s3 = S3-compatible object storage (Cloudflare R2, B2, S3).
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=.storage
OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
PUBLIC_MEDIA_BASE_URL=https://media.numericcvaastucrystal.in        # CDN/custom domain in front of the bucket

# Email (order confirmations, sign-in codes). smtp = e.g. Hostinger mail: smtps://orders%40domain:PASSWORD@smtp.hostinger.com:465
MAIL_DRIVER=smtp
SMTP_URL=
MAIL_FROM=NumericcVaastu Crystal <orders@numericcvaastucrystal.in>
LOG_LEVEL=info
DEV_TOOLS=false                                                     # dev mailbox + payment simulator; refused in production
TRUST_PROXY=1

# ── Web (apps/web) ─────────────────────────────────────────────────────────────
API_INTERNAL_URL=https://api.numericcvaastucrystal.in               # read at BUILD time for the /api/v1 proxy
NEXT_PUBLIC_SITE_URL=https://www.numericcvaastucrystal.in
# WEB_REVALIDATE_SECRET=  (same as above)
