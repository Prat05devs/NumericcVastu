{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express commerce API: the single authority for pricing, stock, orders, payments and the back office",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "jobs": "node --env-file-if-exists=../../.env dist/scripts/run-jobs.js",
    "openapi": "tsx src/scripts/openapi.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sc/contracts": "workspace:*",
    "cookie": "^1.1.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "autocannon": "^8.0.0",
    "mariadb": "3.5.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
