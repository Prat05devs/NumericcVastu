model Affiliate {
  id               String                @id @db.Char(26)
  userId           String?               @unique @map("user_id") @db.Char(26) // partner portal login (role AFFILIATE)
  name             String                @db.VarChar(190)
  email            String?               @unique @db.VarChar(190)
  emailHash        String?               @map("email_hash") @db.Char(64) // self-referral check without decrypting
  phone            String?               @db.VarChar(40)
  platform         String?               @db.VarChar(80)
  handle           String?               @db.VarChar(120)
  commissionJson   Json                  @map("commission_json")
  attributionDays  Int                   @default(30) @map("attribution_days")
  canCreateLinks   Boolean               @default(true) @map("can_create_links")
  status           String                @default("INVITED") @db.VarChar(20) // INVITED | ACTIVE | SUSPENDED
  notes            String                @db.Text
  active           Boolean               @default(true)
  termsVersion     String?               @map("terms_version") @db.VarChar(20)
  termsAcceptedAt  DateTime?             @map("terms_accepted_at") @db.DateTime(3)
  payoutDetailsEnc String?               @map("payout_details_enc") @db.Text // UPI / bank / PAN, AES-256-GCM
  payoutHint       String?               @map("payout_hint") @db.VarChar(60) // e.g. "UPI ••••@okicici · PAN ••••4F"
  createdBy        String?               @map("created_by") @db.Char(26)
  createdAt        DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  links            AffiliateLink[]
  commissions      AffiliateCommission[]
  payouts          AffiliatePayout[]

  @@index([status])
  @@map("affiliates")
}

model AffiliateLink {
  id           String           @id @db.Char(26)
  code         String           @unique @db.VarChar(32) // binary collation set in migration 0002_checks
  affiliateId  String           @map("affiliate_id") @db.Char(26)
  discountId   String?          @map("discount_id") @db.Char(26)
  storefrontId String           @map("storefront_id") @db.VarChar(40)
  targetPath   String           @default("/") @map("target_path") @db.VarChar(255)
  label        String           @default("") @db.VarChar(120)
  active       Boolean          @default(true)
  createdByPartner Boolean      @default(false) @map("created_by_partner")
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  affiliate    Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  discount     Discount?        @relation(fields: [discountId], references: [id], onDelete: SetNull)
  clicks       AffiliateClick[]
  commissions  AffiliateCommission[]

  @@index([affiliateId])
  @@map("affiliate_links")
}

model AffiliateClick {
  id          BigInt        @id @default(autoincrement())
  clickId     String        @unique @map("click_id") @db.Char(26) // goes into the signed attribution token
  linkId      String        @map("link_id") @db.Char(26)
  referrer    String?       @db.VarChar(500)
  userAgent   String?       @map("user_agent") @db.VarChar(300)
  visitorHash String?       @map("visitor_hash") @db.Char(64) // salted hash of IP + user agent; no raw IP stored
  isUnique    Boolean       @default(true) @map("is_unique") // first click by this visitor on this link in 30 min
  suspectedBot Boolean      @default(false) @map("suspected_bot")
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  link        AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([linkId, visitorHash, createdAt])
  @@map("affiliate_clicks")
}

/// One commission per attributed paid order. PENDING until the hold (return window) passes, then APPROVED; reversed
/// in proportion to refunds; PAID once included in a payout. Partners see this ledger without any customer details.
model AffiliateCommission {
  id            String           @id @db.Char(26)
  affiliateId   String           @map("affiliate_id") @db.Char(26)
  linkId        String?          @map("link_id") @db.Char(26)
  orderId       String           @unique @map("order_id") @db.Char(26)
  attribution   String           @db.VarChar(10) // LINK | COUPON
  basisPaise    BigInt           @map("basis_paise") // merchandise paid after discounts, excluding shipping and tax
  amountPaise   BigInt           @map("amount_paise")
  reversedPaise BigInt           @default(0) @map("reversed_paise")
  status        String           @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | REVERSED | REJECTED | PAID
  flags         Json             // e.g. ["SELF_REFERRAL"]
  approvableAt  DateTime         @map("approvable_at") @db.DateTime(3)
  decidedBy     String?          @map("decided_by") @db.Char(26)
  decisionNote  String?          @map("decision_note") @db.VarChar(500)
  payoutId      String?          @map("payout_id") @db.Char(26)
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  affiliate     Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  link          AffiliateLink?   @relation(fields: [linkId], references: [id], onDelete: SetNull)
  payout        AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, status, createdAt])
  @@index([status, approvableAt])
  @@map("affiliate_commissions")
}

/// A payout statement: approved commissions paid together, with any configured tax deduction recorded.
model AffiliatePayout {
  id          String                @id @db.Char(26)
  affiliateId String                @map("affiliate_id") @db.Char(26)
  grossPaise  BigInt                @map("gross_paise")
  tdsPaise    BigInt                @map("tds_paise")
  netPaise    BigInt                @map("net_paise")
  status      String                @default("PENDING") @db.VarChar(20) // PENDING | PAID | CANCELLED
  method      String?               @db.VarChar(40)
  reference   String?               @db.VarChar(120) // bank / UPI transaction reference
  paidAt      DateTime?             @map("paid_at") @db.DateTime(3)
  createdBy   String?               @map("created_by") @db.Char(26)
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  commissions AffiliateCommission[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_payouts")
}

/// Encrypted credentials managed from the back office (payment keys, AI keys). AES-256-GCM with ENCRYPTION_KEY.
model Secret {
  name       String   @id @db.VarChar(100)
  ciphertext String   @db.Text
  last4      String   @db.VarChar(8)
  updatedBy  String?  @map("updated_by") @db.Char(26)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("secrets")
}

/// One-time sign-in codes for customers. Only a hash is stored; attempts are capped.
model OtpChallenge {
  id         String    @id @db.Char(26)
  email      String    @db.VarChar(254)
  codeHash   String    @map("code_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  consumedAt DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([email, createdAt])
  @@map("otp_challenges")
}
