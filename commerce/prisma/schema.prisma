// Sacred Commerce / NumericcVaastu Crystal — MySQL 8+ / MariaDB 10.6+ (Hostinger managed MySQL).
// 46 architecture entities (Section 05) + 7 documented extensions (docs/adr/0011-shared-back-office.md).
// Conventions: ids CHAR(26) ULID; money BIGINT paise; times DATETIME(3) UTC; DB snake_case, TS camelCase via @map.
// CHECK constraints that Prisma cannot express live in migration 0002_checks (raw SQL).

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────────── Identity & customers (4)

model User {
  id             String    @id @db.Char(26)
  email          String?   @unique @db.VarChar(254)
  phone          String?   @unique @db.VarChar(20)
  name           String?   @db.VarChar(120)
  role           String    @default("CUSTOMER") @db.VarChar(20)
  status         String    @default("ACTIVE") @db.VarChar(20)
  verifiedAt     DateTime? @map("verified_at") @db.DateTime(3)
  passwordHash   String?   @map("password_hash") @db.VarChar(255)
  mfaSecretEnc   String?   @map("mfa_secret_enc") @db.Text
  mfaEnabledAt   DateTime? @map("mfa_enabled_at") @db.DateTime(3)
  failedLogins   Int       @default(0) @map("failed_logins")
  lockedUntil    DateTime? @map("locked_until") @db.DateTime(3)
  lastLoginAt    DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  sessions       Session[]
  addresses      CustomerAddress[]
  consents       CustomerConsent[]
  orders         Order[]
  carts          Cart[]
  customRequests CustomRequest[]

  @@index([role, status])
  @@map("users")
}

model Session {
  id             String    @id @db.Char(26)
  userId         String    @map("user_id") @db.Char(26)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  kind           String    @default("CUSTOMER") @db.VarChar(10) // CUSTOMER | STAFF
  mfaVerified    Boolean   @default(false) @map("mfa_verified")
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)
  deviceMetadata Json?     @map("device_metadata")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model CustomerAddress {
  id         String   @id @db.Char(26)
  userId     String   @map("user_id") @db.Char(26)
  label      String?  @db.VarChar(40)
  fullName   String   @map("full_name") @db.VarChar(120)
  phone      String   @db.VarChar(20)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  locality   String?  @db.VarChar(120)
  city       String   @db.VarChar(80)
  region     String   @db.VarChar(80)
  postalCode String   @map("postal_code") @db.VarChar(10)
  country    String   @default("IN") @db.Char(2)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_addresses")
}

model CustomerConsent {
  id         String   @id @db.Char(26)
  userId     String?  @map("user_id") @db.Char(26)
  subjectRef String?  @map("subject_ref") @db.Char(64) // email hash for guests
  purpose    String   @db.VarChar(40) // OPERATIONAL | MARKETING | CUSTOM_REQUEST | CONSULTATION
  version    String   @db.VarChar(20)
  acceptedAt DateTime @map("accepted_at") @db.DateTime(3)
  source     String   @db.VarChar(40)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, purpose])
  @@map("customer_consents")
}

// ───────────────────────────── Catalogue & media (14)

model Category {
  id          String     @id @db.Char(26)
  parentId    String?    @map("parent_id") @db.Char(26)
  slug        String     @unique @db.VarChar(160)
  title       String     @db.VarChar(160)
  kind        String     @db.VarChar(20) // RUDRAKSHA | GEMSTONE | CRYSTAL | YANTRA | WATCH | COURSE | CONSULTATION
  status      String     @default("ACTIVE") @db.VarChar(20)
  sortOrder   Int        @default(0) @map("sort_order")
  intro       String?    @db.Text
  storefrontId String    @default("crystal") @map("storefront_id") @db.VarChar(40)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  attributes  AttributeDefinition[]
  storefront  Storefront @relation(fields: [storefrontId], references: [id])

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Collection {
  id             String              @id @db.Char(26)
  slug           String              @unique @db.VarChar(160)
  title          String              @db.VarChar(160)
  description    String?             @db.Text
  ruleJson       Json?               @map("rule_json")
  status         String              @default("DRAFT") @db.VarChar(20)
  seoTitle       String?             @map("seo_title") @db.VarChar(70)
  seoDescription String?             @map("seo_description") @db.VarChar(170)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  products       CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String     @map("collection_id") @db.Char(26)
  productId    String     @map("product_id") @db.Char(26)
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

model Product {
  id               String                  @id @db.Char(26)
  categoryId       String                  @map("category_id") @db.Char(26)
  slug             String                  @unique @db.VarChar(160)
  title            String                  @db.VarChar(200)
  productType      String                  @default("PRODUCT") @map("product_type") @db.VarChar(20) // PRODUCT | CUSTOM_REQUEST | SERVICE
  status           String                  @default("DRAFT") @db.VarChar(20) // DRAFT | PUBLISHED | ARCHIVED
  shortDescription String                  @default("") @map("short_description") @db.VarChar(500)
  body             String                  @db.Text
  seoTitle         String?                 @map("seo_title") @db.VarChar(70)
  seoDescription   String?                 @map("seo_description") @db.VarChar(170)
  taxGroup         String?                 @map("tax_group") @db.VarChar(40)
  shippingProfile  String?                 @map("shipping_profile") @db.VarChar(40)
  returnEligible   Boolean?                @map("return_eligible")
  isDemo           Boolean                 @default(false) @map("is_demo")
  featured         Boolean                 @default(false)
  version          Int                     @default(0)
  publishedAt      DateTime?               @map("published_at") @db.DateTime(3)
  publishedBy      String?                 @map("published_by") @db.Char(26)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  category         Category                @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  media            ProductMedia[]
  attributeValues  ProductAttributeValue[]
  collections      CollectionProduct[]
  rudraksha        RudrakshaSpec?
  crystal          CrystalSpec?
  yantra           YantraSpec?
  reviews          Review[]

  @@index([categoryId, status, publishedAt, id])
  @@index([status, featured])
  @@map("products")
}

model ProductVariant {
  id              String                  @id @db.Char(26)
  productId       String                  @map("product_id") @db.Char(26)
  sku             String                  @unique @db.VarChar(64)
  title           String                  @db.VarChar(200)
  optionJson      Json                    @map("option_json")
  pricePaise      BigInt                  @map("price_paise")
  compareAtPaise  BigInt?                 @map("compare_at_paise")
  status          String                  @default("ACTIVE") @db.VarChar(20)
  weightG         Int                     @map("weight_g")
  uniqueSpecimen  Boolean                 @default(false) @map("unique_specimen")
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory       InventoryItem?
  media           ProductMedia[]
  attributeValues ProductAttributeValue[]
  gemstone        GemstoneSpec?
  certificates    Certificate[]
  cartItems       CartItem[]
  orderLines      OrderLine[]
  reservations    InventoryReservation[]
  movements       InventoryMovement[]

  @@index([productId, status])
  @@map("product_variants")
}

model AttributeDefinition {
  id         String            @id @db.Char(26)
  code       String            @unique @db.VarChar(60)
  label      String            @db.VarChar(120)
  type       String            @db.VarChar(20)
  unit       String?           @db.VarChar(20)
  filterable Boolean           @default(false)
  searchable Boolean           @default(false)
  required   Boolean           @default(false)
  categoryId String?           @map("category_id") @db.Char(26)
  category   Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options    AttributeOption[]
  values     ProductAttributeValue[]

  @@index([categoryId])
  @@map("attribute_definitions")
}

model AttributeOption {
  id           String              @id @db.Char(26)
  definitionId String              @map("definition_id") @db.Char(26)
  value        String              @db.VarChar(120)
  label        String              @db.VarChar(120)
  sortOrder    Int                 @default(0) @map("sort_order")
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, value])
  @@map("attribute_options")
}

model ProductAttributeValue {
  id              String              @id @db.Char(26)
  productId       String              @map("product_id") @db.Char(26)
  variantId       String?             @map("variant_id") @db.Char(26)
  definitionId    String              @map("definition_id") @db.Char(26)
  valueText       String?             @map("value_text") @db.VarChar(500)
  valueNumber     Decimal?            @map("value_number") @db.Decimal(14, 4)
  normalizedValue String              @map("normalized_value") @db.VarChar(160)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  definition      AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, definitionId])
  @@index([definitionId, normalizedValue, productId])
  @@map("product_attribute_values")
}

model ProductMedia {
  id         String          @id @db.Char(26)
  productId  String          @map("product_id") @db.Char(26)
  variantId  String?         @map("variant_id") @db.Char(26)
  objectKey  String          @map("object_key") @db.VarChar(400)
  altText    String          @map("alt_text") @db.VarChar(250)
  position   Int             @default(0) @map("sort_order")
  visibility String          @default("PUBLIC") @db.VarChar(20)
  width      Int?
  height     Int?
  authorized Boolean         @default(false) // admin confirms the photo is original / licensed
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_media")
}

model RudrakshaSpec {
  productId  String   @id @map("product_id") @db.Char(26)
  mukhiCount Int      @map("mukhi_count")
  origin     String   @db.VarChar(60)
  beadType   String   @map("bead_type") @db.VarChar(60)
  sizeMm     Decimal  @map("size_mm") @db.Decimal(6, 2)
  notes      String?  @db.Text
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([mukhiCount])
  @@map("rudraksha_specs")
}

model GemstoneSpec {
  variantId    String         @id @map("variant_id") @db.Char(26)
  mineral      String         @db.VarChar(80)
  variety      String         @db.VarChar(80)
  caratDecimal Decimal        @map("carat_decimal") @db.Decimal(8, 3)
  rattiDecimal Decimal?       @map("ratti_decimal") @db.Decimal(8, 3)
  cut          String         @db.VarChar(60)
  treatment    String         @db.VarChar(60)
  origin       String         @db.VarChar(80)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([mineral, variety])
  @@map("gemstone_specs")
}

model CrystalSpec {
  productId      String  @id @map("product_id") @db.Char(26)
  mineral        String  @db.VarChar(80)
  form           String  @db.VarChar(60)
  beadSizeMm     Decimal? @map("bead_size_mm") @db.Decimal(6, 2)
  dimensionsJson Json?   @map("dimensions_json")
  baseMaterial   String? @map("base_material") @db.VarChar(80)
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([mineral, form])
  @@map("crystal_specs")
}

model YantraSpec {
  productId         String  @id @map("product_id") @db.Char(26)
  yantraType        String  @map("yantra_type") @db.VarChar(80)
  material          String  @db.VarChar(60)
  dimensionsJson    Json?   @map("dimensions_json")
  usageInstructions String? @map("usage_instructions") @db.Text
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([yantraType])
  @@map("yantra_specs")
}

model Certificate {
  id               String         @id @db.Char(26)
  productVariantId String         @map("product_variant_id") @db.Char(26)
  issuer           String         @db.VarChar(160)
  reportNo         String?        @unique @map("report_no") @db.VarChar(80)
  reportType       String         @map("report_type") @db.VarChar(80)
  issuedOn         DateTime?      @map("issued_on") @db.Date
  objectKey        String?        @map("object_key") @db.VarChar(400)
  verifiedStatus   String         @default("UNVERIFIED") @map("verified_status") @db.VarChar(20) // UNVERIFIED | VERIFIED | REJECTED
  disclosureJson   Json           @map("disclosure_json")
  evidenceNote     String         @map("evidence_note") @db.VarChar(500)
  isDemo           Boolean        @default(false) @map("is_demo")
  verifiedBy       String?        @map("verified_by") @db.Char(26)
  verifiedAt       DateTime?      @map("verified_at") @db.DateTime(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([productVariantId])
  @@map("certificates")
}

// ───────────────────────────── Inventory, pricing & cart (7)

model InventoryItem {
  variantId    String         @id @map("variant_id") @db.Char(26)
  onHandQty    Int            @default(0) @map("on_hand_qty")
  reservedQty  Int            @default(0) @map("reserved_qty")
  reorderLevel Int            @default(0) @map("reorder_level")
  version      Int            @default(0)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.DateTime(3)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory_items")
}

model InventoryReservation {
  id         String         @id @db.Char(26)
  orderId    String         @map("order_id") @db.Char(26)
  variantId  String         @map("variant_id") @db.Char(26)
  qty        Int
  status     String         @default("HELD") @db.VarChar(20)
  expiresAt  DateTime       @map("expires_at") @db.DateTime(3)
  releasedAt DateTime?      @map("released_at") @db.DateTime(3)
  consumedAt DateTime?      @map("consumed_at") @db.DateTime(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model InventoryMovement {
  id            String         @id @db.Char(26)
  variantId     String         @map("variant_id") @db.Char(26)
  kind          String         @db.VarChar(30) // RECEIPT | ADJUSTMENT | DAMAGE | CORRECTION | SALE | RETURN_RESTOCK
  qtyDelta      Int            @map("qty_delta")
  referenceType String?        @map("reference_type") @db.VarChar(40)
  referenceId   String?        @map("reference_id") @db.VarChar(40)
  note          String?        @db.VarChar(500)
  actorId       String?        @map("actor_id") @db.Char(26)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

model Cart {
  id             String     @id @db.Char(26)
  userId         String?    @map("user_id") @db.Char(26)
  guestTokenHash String?    @unique @map("guest_token_hash") @db.Char(64)
  storefrontId   String     @default("crystal") @map("storefront_id") @db.VarChar(40)
  expiresAt      DateTime   @map("expires_at") @db.DateTime(3)
  currency       String     @default("INR") @db.Char(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          CartItem[]

  @@index([userId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  cartId    String         @map("cart_id") @db.Char(26)
  variantId String         @map("variant_id") @db.Char(26)
  qty       Int
  addedAt   DateTime       @default(now()) @map("added_at") @db.DateTime(3)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
  @@map("cart_items")
}

model Discount {
  id               String               @id @db.Char(26)
  code             String?              @unique @db.VarChar(40)
  description      String               @default("") @db.VarChar(255)
  type             String               @db.VarChar(10) // PERCENT | FIXED
  value            BigInt // basis points for PERCENT, paise for FIXED
  startsAt         DateTime?            @map("starts_at") @db.DateTime(3)
  endsAt           DateTime?            @map("ends_at") @db.DateTime(3)
  capPaise         BigInt?              @map("cap_paise")
  minOrderPaise    BigInt?              @map("min_order_paise")
  limitTotal       Int?                 @map("limit_total")
  limitPerCustomer Int?                 @map("limit_per_customer")
  redeemedCount    Int                  @default(0) @map("redeemed_count")
  eligibleRulesJson Json                @map("eligible_rules_json") // {families[], productIds[], storefronts[]}
  combinable       Boolean              @default(false)
  active           Boolean              @default(true)
  version          Int                  @default(0)
  createdBy        String?              @map("created_by") @db.Char(26)
  createdAt        DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  redemptions      DiscountRedemption[]
  affiliateLinks   AffiliateLink[]

  @@index([active, startsAt, endsAt])
  @@map("discounts")
}

model DiscountRedemption {
  id          String    @id @db.Char(26)
  discountId  String    @map("discount_id") @db.Char(26)
  orderId     String    @unique @map("order_id") @db.Char(26)
  userId      String?   @map("user_id") @db.Char(26)
  customerRef String?   @map("customer_ref") @db.Char(64)
  status      String    @default("RESERVED") @db.VarChar(20) // RESERVED | REDEEMED | RELEASED
  redeemedAt  DateTime  @default(now()) @map("redeemed_at") @db.DateTime(3)
  discount    Discount  @relation(fields: [discountId], references: [id], onDelete: Restrict)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([discountId, customerRef])
  @@map("discount_redemptions")
}

// ───────────────────────────── Order, payment & delivery (11)

model Order {
  id                String                 @id @db.Char(26)
  publicCode        String                 @unique @map("public_code") @db.VarChar(20)
  accessTokenHash   String                 @map("access_token_hash") @db.Char(64) // guest order link, never enumerable
  userId            String?                @map("user_id") @db.Char(26)
  email             String                 @db.VarChar(254)
  storefrontId      String                 @default("crystal") @map("storefront_id") @db.VarChar(40)
  status            String                 @default("AWAITING_PAYMENT") @db.VarChar(30)
  paymentStatus     String                 @default("CREATED") @map("payment_status") @db.VarChar(30)
  fulfillmentStatus String                 @default("UNFULFILLED") @map("fulfillment_status") @db.VarChar(30)
  currency          String                 @default("INR") @db.Char(3)
  subtotalPaise     BigInt                 @map("subtotal_paise")
  discountPaise     BigInt                 @map("discount_paise")
  shippingPaise     BigInt                 @map("shipping_paise")
  taxPaise          BigInt                 @map("tax_paise")
  totalPaise        BigInt                 @map("total_paise")
  refundedPaise     BigInt                 @default(0) @map("refunded_paise")
  taxMode           String                 @map("tax_mode") @db.VarChar(12)
  priceVersion      String                 @map("price_version") @db.VarChar(64)
  shippingMethodId  String                 @map("shipping_method_id") @db.VarChar(40)
  pricingSnapshot   Json                   @map("pricing_snapshot")
  discountId        String?                @map("discount_id") @db.Char(26)
  campaignId        String?                @map("campaign_id") @db.Char(26)
  affiliateLinkId   String?                @map("affiliate_link_id") @db.Char(26)
  affiliateClickId  String?                @map("affiliate_click_id") @db.Char(26)
  commissionPaise   BigInt                 @default(0) @map("commission_paise")
  paymentDueAt      DateTime               @map("payment_due_at") @db.DateTime(3)
  paidAt            DateTime?              @map("paid_at") @db.DateTime(3)
  cancelledAt       DateTime?              @map("cancelled_at") @db.DateTime(3)
  customRequestId   String?                @map("custom_request_id") @db.Char(26)
  createdAt         DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines             OrderLine[]
  addresses         OrderAddress[]
  payments          Payment[]
  refunds           Refund[]
  shipments         Shipment[]
  returns           ReturnRequest[]
  events            OrderEvent[]
  reservations      InventoryReservation[]
  redemption        DiscountRedemption?

  @@index([userId, createdAt, id])
  @@index([status, createdAt])
  @@index([paymentDueAt, status])
  @@map("orders")
}

model OrderLine {
  id                      String         @id @db.Char(26)
  orderId                 String         @map("order_id") @db.Char(26)
  variantId               String         @map("variant_id") @db.Char(26)
  skuSnapshot             String         @map("sku_snapshot") @db.VarChar(64)
  titleSnapshot           String         @map("title_snapshot") @db.VarChar(300)
  attributesSnapshotJson  Json           @map("attributes_snapshot_json")
  qty                     Int
  unitPricePaise          BigInt         @map("unit_price_paise")
  discountPaise           BigInt         @map("discount_paise")
  taxPaise                BigInt         @map("tax_paise")
  totalPaise              BigInt         @map("total_paise")
  order                   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant                 ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reviews                 Review[]

