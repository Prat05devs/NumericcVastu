{
  "name": "numericcvaastu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Back office and commerce API shared by numericcvaastu.com and numericcvaastucrystal.in",
  "scripts": {
    "dev": "next dev --webpack --port 4000",
    "build": "next build --webpack",
    "start": "next start --port 4000",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:sync-website": "node --experimental-strip-types scripts/sync-website-catalogue.ts",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
