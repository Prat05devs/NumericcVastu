# Copy to .env.local. In production set these in the hosting environment (Vercel → Project → Settings → Environment Variables).

# MySQL 8.0+ or MariaDB 10.6+ connection string. On Hostinger: hPanel → Databases → MySQL Databases (create the
# database and user, then use host "localhost" when the backend runs on the same hosting, or the remote host name
# with Remote MySQL enabled when it runs elsewhere). Locally: `npm run db:up` and the value below.
DATABASE_URL=mysql://nv:nvpass@127.0.0.1:3306/numericcvaastu
# Set to true when the database requires TLS (usually for remote connections).
DATABASE_SSL=

# 32 random bytes, base64. Encrypts every payment and AI key saved from the dashboard. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: without it the saved keys cannot be read.
SETTINGS_ENCRYPTION_KEY=

# Lets the first owner account be created at /admin/login (asked for on the setup form). Remove it after setup.
ADMIN_SETUP_TOKEN=

# The public address of this backend, used to build affiliate links (https://go.numericcvaastu.com/r/AbC…).
PUBLIC_BASE_URL=http://localhost:4000
