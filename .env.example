# The canonical address search engines list. numericcvaastu.in and .org also serve the site on their own address.
NEXT_PUBLIC_SITE_URL=https://www.numericcvaastu.com
# Optional: ownership meta tags for Google Search Console and Bing Webmaster Tools (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional: open the visitor's email application after they prepare an enquiry.
NEXT_PUBLIC_CONTACT_EMAIL=
# Legacy prototype setting; current booking flow uses the booking page.
NEXT_PUBLIC_BOOKING_URL=
# Razorpay (Dashboard > Account & Settings > API Keys). Test keys start with rzp_test_ and let every
# offer be paid in test mode; live keys charge only offers with priceVerified + checkoutEnabled in src/data/offers.ts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Visitors outside India pay in US dollars. Razorpay takes USD only after International payments are enabled
# on the account; then set this to on.
RAZORPAY_INTERNATIONAL=
# Razorpay webhook (Dashboard > Webhooks). URL: https://<domain>/api/razorpay/webhook
# Events: payment.captured, payment.failed, order.paid, refund.processed. Use the same secret here.
RAZORPAY_WEBHOOK_SECRET=
# Optional: receives a JSON summary of each payment event (Google Apps Script, Zapier or Make catch hook).
BOOKING_NOTIFY_URL=
# PayPal for visitors outside India (developer.paypal.com > Apps & Credentials). PAYPAL_ENV=live for real
# payments; anything else uses the sandbox. Live payments, like Razorpay, need priceVerified + checkoutEnabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: live Instagram follower, following and post counts, refreshed every five days (docs/INSTAGRAM.md).
# A Facebook Page access token (never expires) plus the Instagram business account ID.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
